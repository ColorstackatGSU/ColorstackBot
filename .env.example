DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# The member portal's API. /verify reads members from here rather than from the form's
# response tab, so a Discord handle corrected in the portal is the one that counts.
# BOT_SHARED_SECRET must match the value set on the backend.
PORTAL_API_URL=
BOT_SHARED_SECRET=

# Still needed: the bot owns the `members` and `pending_verifications` tabs, and admin
# approvals read the form's response tab directly.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=
FORM_RESPONSES_SHEET=Form Responses 1
MEMBERS_SHEET=members
GSU_ROLE_ID=
NATIONAL_ROLE_ID=
GUILD_ID=
PENDING_CHANNEL_ID=
UNVERIFIED_CHANNEL_ID=
GSU_FORM_URL=
COLORSTACK_APPLICATION_URL=
GSU_EMAIL_DOMAINS=student.gsu.edu,gsu.edu
