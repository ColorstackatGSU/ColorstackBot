DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# The member portal's API. /verify reads members from here rather than from the form's
# response tab, so a Discord handle corrected in the portal is the one that counts.
# BOT_SHARED_SECRET must match the value set on the backend.
PORTAL_API_URL=
BOT_SHARED_SECRET=

# Still needed, but only for the two tabs the bot owns: `members` and
# `pending_verifications`. Nothing reads the form's response tab any more, so
# FORM_RESPONSES_SHEET below is dead and goes when those two tabs move to the database.
# Note this key is granted read-write on the whole spreadsheet, unlike the backend's,
# which is read-only by default.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=
MEMBERS_SHEET=members
GSU_ROLE_ID=
NATIONAL_ROLE_ID=
GUILD_ID=
PENDING_CHANNEL_ID=
UNVERIFIED_CHANNEL_ID=
GSU_FORM_URL=
COLORSTACK_APPLICATION_URL=
GSU_EMAIL_DOMAINS=student.gsu.edu,gsu.edu
